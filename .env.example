# OpenWeatherMap (One Call + Air Pollution share one key)
OPENWEATHER_API_KEY=

# NASA FIRMS
FIRMS_MAP_KEY=

# ACLED conflict data (free registration at https://acleddata.com/register)
# Default: disabled in sources.yaml until credentials are configured
ACLED_EMAIL=
ACLED_PASSWORD=

# GloFAS / Copernicus CDS (sidecar only — used by Python subprocess)
CDS_API_KEY=
CDS_API_URL=https://cds.climate.copernicus.eu/api

# Optional auth token for /safety/* endpoints
# If set, all requests require X-API-Key: <token> header
AUTH_TOKEN=

# Data directory (overridable for Docker volumes)
DATA_DIR=./data

# Deferred / not wired for MVP
NUMBEO_API_KEY=
GEOSURE_API_KEY=

PORT=3000